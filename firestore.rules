rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. KONTAKTSKJEMA (/inquiries og /contact_requests)
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.restaurant_name is string
                    && request.resource.data.restaurant_name.size() > 0
                    && request.resource.data.restaurant_name.size() <= 120;
      allow read, update, delete: if true; // Sett til 'request.auth != null' hvis kun innlogget Firebase-bruker skal lese
    }

    match /contact_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // 2. RESTAURANTER OG MENYER (/restaurants/{restaurantId})
    match /restaurants/{restaurantId} {
      // Alle gjester og admin-panelet kan lese restaurantinfo
      allow read: if true;

      // Tillat opprettelse og oppdatering fra Admin-panelet (med gyldige felttyper)
      allow create, update: if (!('name' in request.resource.data) || request.resource.data.name is string)
                            && (!('categories' in request.resource.data) || request.resource.data.categories is list);

      // Bare admin-kontoene kan slette en hel restaurant.
      // (Før: alle innloggede. Etter at Google-innlogging ble skrudd på, ville det vært hvem som helst.)
      allow delete: if isShopAdmin();

      // Undersamling: Menyelementer/retter (/menu_items/{itemId})
      match /menu_items/{itemId} {
        allow read: if true;

        // Krever at en rett alltid har et gyldig navn (streng) og en gyldig pris (tall >= 0)
        allow create, update: if request.resource.data.name is string
                              && request.resource.data.name.size() > 0
                              && request.resource.data.name.size() <= 150
                              && request.resource.data.price is number
                              && request.resource.data.price >= 0;

        // Tillat at restauranteier med PIN-kode kan slette retter fra menyen
        allow delete: if true;
      }

      // Eventuelle andre undersamlinger (f.eks. bordvarsler / service_bell).
      // Unntak: NfcReview-ordrene (restaurants/aabakstudio/orders) har egne regler under.
      match /{sub}/{rest=**} {
        allow read, write: if !(restaurantId == 'aabakstudio' && sub == 'orders');
      }
    }

    // 1b. Ordrer fra NfcReview-butikken (aabakstudio.com/NfcReview):
    // - Kunder kan bare opprette en ny ordre, og bare med gyldige felt.
    // - Kunder kan hente én ordre med det lange ordrenummeret (sporingssiden). Ingen kan liste alle.
    // - Bare admin-kontoen (Google-innlogging) kan liste, endre og slette.
    match /restaurants/aabakstudio/orders/{orderId} {
      allow get: if isShopAdmin() || isSecureOrderId(orderId);
      allow list, update, delete: if isShopAdmin();
      allow create: if isShopAdmin() || isValidNewOrder(orderId);
    }

    // Bruker-ID-ene til admin-kontoene (samme liste som ADMIN_UIDS i NfcReview/src/utils/firebase.ts).
    function isShopAdmin() {
      return request.auth != null
        && request.auth.uid in ['9t6J2r8E3mhW3SaX5v4hP0PD71C2', 'MW6Ssb83uwPlFfFHHD8Vu1Y6hRe2'];
    }

    // Samme format som generateOrderId() i NfcReview: NFC-XXXX-XXXX-XXXX (60 bit tilfeldighet).
    function isSecureOrderId(id) {
      return id.matches('^NFC-[2-9A-HJ-NP-Z]{4}-[2-9A-HJ-NP-Z]{4}-[2-9A-HJ-NP-Z]{4}$');
    }

    function isShortString(v, max) {
      return v is string && v.size() <= max;
    }

    function isAmount(v) {
      return v is int && v >= 0 && v <= 100000;
    }

    function isValidNewOrder(id) {
      let d = request.resource.data;
      return isSecureOrderId(id)
        && d.keys().hasOnly(['orderId', 'createdAt', 'status', 'total', 'subtotal', 'discountAmount',
             'shippingFee', 'companyName', 'contactPerson', 'email', 'phone', 'address', 'postalCode',
             'city', 'orgNumber', 'googleReviewUrl', 'reviewInputMode', 'googleLookupName',
             'googleLookupCity', 'trackingNumber', 'adminNotes', 'paymentMethod', 'itemsJson',
             'checklistJson', 'updatedAt'])
        && d.keys().hasAll(['orderId', 'createdAt', 'status', 'total', 'companyName', 'contactPerson',
             'email', 'itemsJson'])
        && d.orderId == id
        && d.status == 'ny'
        && d.get('trackingNumber', '') == ''
        && d.get('adminNotes', '') == ''
        && isAmount(d.total) && isAmount(d.get('subtotal', 0))
        && isAmount(d.get('discountAmount', 0)) && isAmount(d.get('shippingFee', 0))
        && isShortString(d.createdAt, 40) && isShortString(d.get('updatedAt', ''), 40)
        && isShortString(d.companyName, 200) && d.companyName.size() > 0
        && isShortString(d.contactPerson, 200) && d.contactPerson.size() > 0
        && isShortString(d.email, 200) && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && isShortString(d.get('phone', ''), 40)
        && isShortString(d.get('address', ''), 300)
        && isShortString(d.get('postalCode', ''), 20)
        && isShortString(d.get('city', ''), 100)
        && isShortString(d.get('orgNumber', ''), 40)
        && isShortString(d.get('googleReviewUrl', ''), 1000)
        && isShortString(d.get('reviewInputMode', ''), 20)
        && isShortString(d.get('googleLookupName', ''), 200)
        && isShortString(d.get('googleLookupCity', ''), 100)
        && isShortString(d.get('paymentMethod', ''), 40)
        && isShortString(d.itemsJson, 50000)
        && isShortString(d.get('checklistJson', ''), 500);
    }
  }
}
