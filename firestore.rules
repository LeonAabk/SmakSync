rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Restauranter og alle under-samlinger (menu_items, drift, etc.):
    match /restaurants/{restaurantId} {
      allow read, write: if true;

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // 2. Kontakthenvendelser og prisforespørsler:
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    match /contact_requests/{requestId} {
      allow read, write: if true;
    }

    // 3. Generell tilgang for SmakSync (sikrer at ingen operasjoner avvises):
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
